#include <winver.h>

IDI_ICON1 ICON "assets/edrshield.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION 1,0,0,0
  PRODUCTVERSION 1,0,0,0
  FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
  FILEFLAGS 0
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "alvarofraguas"
      VALUE "FileDescription", "EDR Shield - WFP/QoS Tamper Protection"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "edrshield"
      VALUE "LegalCopyright", "Copyright (c) 2026 alvarofraguas. MIT License."
      VALUE "OriginalFilename", "edrshield.exe"
      VALUE "ProductName", "EdrShield Community Edition"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
